{
  "name": "alorun",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/swagger": "12.1.0",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@sentry/nestjs": "11.11.0",
    "@sentry/react-native": "8.28.0",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "5.106.1",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.4",
    "expo": "58.0.23",
    "expo-crypto": "58.0.7",
    "expo-notifications": "58.1.8",
    "expo-router": "58.0.30",
    "graphile-worker": "0.18.0",
    "nativewind": "4.2.7",
    "openai": "7.52.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-worklets": "0.13.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tailwindcss": "^3.4.19",
    "text-encoding": "0.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.16",
    "cron-parser": "5.10.6",
    "expo-audio": "58.0.11",
    "expo-file-system": "58.0.13",
    "expo-secure-store": "58.0.2",
    "expo-speech": "58.0.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "esbuild": "0.28.2",
    "typescript-eslint": "8.72.2"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "chat:server": "node server/index.mjs",
    "test": "pnpm api:build && node --test dist/tests/*.test.js tests/*.test.mjs",
    "api:build": "tsc -p api/tsconfig.json",
    "api:start": "node --env-file=.env dist/api/main.js",
    "format:check": "prettier --check app src api serverless scripts/*.mjs tests/*.ts docs/tasks/*.md docs/adr/0003-goal-schedules-voice.md docs/adr/0004-companion-voice-chat.md docs/adr/0005-missions.md docs/execution-layer.md docs/missions.md",
    "lint": "eslint app src api serverless tests/*.ts",
    "missions:build": "tsc -p serverless/tsconfig.json && node scripts/build-missions.mjs",
    "missions:smoke": "deno run --config supabase/functions/missions/deno.json --allow-env --allow-net=127.0.0.1:55432 --allow-read --allow-sys scripts/test-missions-edge.mjs"
  }
}
