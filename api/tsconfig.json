{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "outDir": "../dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "../db/**/*.ts",
    "../src/shared/**/*.ts",
    "../src/domain/**/*.ts",
    "../tests/**/*.test.ts"
  ]
}
