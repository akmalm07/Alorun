# Supply credentials via a secret manager; never commit real values.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres"

# Development chat server; do not put the OpenAI key into the mobile app.
OPENAI_API_KEY=""
OPENAI_MODELS=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODELS=""
SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_ANON_KEY=""
# These public values identify the auth project and HTTPS chat service, not secrets.
EXPO_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY=""
EXPO_PUBLIC_CHAT_API_URL="https://YOUR-DEVELOPMENT-CHAT-SERVER"
# Used by the optional local migration command.
CHAT_API_URL="https://YOUR-DEVELOPMENT-CHAT-SERVER"
