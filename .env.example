# Supply credentials via a secret manager; never commit real values.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres"

# API only. Use a backend database role; all mobile access goes through JWT-verified API.
SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_PUBLISHABLE_OR_ANON_KEY"
OPENAI_API_KEY="YOUR_SERVER_ONLY_KEY"
# Select available models and current prices for your provider account.
OPENAI_MODEL="YOUR_STRUCTURED_OUTPUT_MODEL"
OPENAI_TRANSCRIPTION_MODEL="YOUR_TRANSCRIPTION_MODEL"
AI_INPUT_USD_PER_MILLION="REPLACE_WITH_CURRENT_PRICE"
AI_OUTPUT_USD_PER_MILLION="REPLACE_WITH_CURRENT_PRICE"
AI_TRANSCRIPTION_USD_PER_MINUTE="REPLACE_WITH_CURRENT_PRICE"
AI_DAILY_REQUEST_LIMIT="3"
PORT="3000"

# Bundled into the mobile app: public configuration only. Never add a service-role/API secret.
EXPO_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="YOUR_PUBLISHABLE_OR_ANON_KEY"
EXPO_PUBLIC_API_URL="https://YOUR_API_HOST"

# Optional server-only chat history encryption. Leave unset for temporary chat only.
# Generate a 32-byte key with `openssl rand -hex 32`; keep it in the server secret manager.
# Set CHAT_ENCRYPTION_KEY to the resulting 64 hexadecimal characters. Do not rotate without re-encrypting stored history.

# Optional Missions platform. Leave worker URL/secret/storage key unset to save paused missions only.
# Fixed bucket name matches the restrictive policy in supabase/setup/missions-storage.sql.
MISSION_BUCKET="alorun-missions"
# Server-only: configure these in secret management; never use EXPO_PUBLIC_*.
# MISSION_STORAGE_SERVICE_KEY=<Supabase service-role/secret key with Storage access>
# MISSION_WORKER_URL=https://PROJECT.supabase.co/functions/v1/missions
# MISSION_WORKER_SECRET=<generate with openssl rand -hex 32>
