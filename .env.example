# Expo public values are embedded in the app. Use a reachable API origin, never a secret.
# Android emulator: http://10.0.2.2:3000; physical device: http://YOUR_LAN_IP:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Server only: set these in your shell or deployment environment.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
PORT=3000
# Optional, comma-separated allowed origins for web clients.
CORS_ORIGINS=http://localhost:8081
